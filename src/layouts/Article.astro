---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Callout from '../components/Callout.astro';
import { CATEGORIAS } from '../content.config';
import { AUTHOR } from '../consts';

interface Props {
  title: string; description: string; pubDate: Date; updatedDate?: Date;
  categoria: keyof typeof CATEGORIAS; tags?: string[]; meta?: string; eyebrow?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, pubDate, updatedDate, categoria, tags = [], meta, eyebrow, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description} type="article">
  <article class="container">
    <header class="page-head">
      <p class="eyebrow">{eyebrow ?? CATEGORIAS[categoria]}</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <p class="byline muted">
        {AUTHOR} · <FormattedDate date={pubDate} />
        {updatedDate && <> · actualizado <FormattedDate date={updatedDate} /></>}
        {meta && <> · {meta}</>}
      </p>
      <div class="tags">
        <a class="tag cat" href={`/categorias/${categoria}/`}>{CATEGORIAS[categoria]}</a>
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    </header>
    <div class="layout">
      <div class="prose"><slot /></div>
      {toc.length > 2 && (
        <aside class="toc" aria-label="Contenido">
          <p class="eyebrow">Contenido</p>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
    <div class="prose">
      <Callout tipo="advertencia" titulo="Uso ético y responsable">
        <p>Este contenido es educativo. Practica solo en sistemas propios o con autorización expresa y por escrito. Lee el <a href="/aviso-etico/">aviso ético y legal</a>.</p>
      </Callout>
    </div>
  </article>
</Base>
<style>
  .byline { font-size: .9rem; margin-top: .8rem !important; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 760px) 220px; gap: 3rem; justify-content: space-between; }
  .toc { position: sticky; top: 90px; align-self: start; font-size: .88rem; }
  .toc ul { list-style: none; padding: 0; margin: .5rem 0; } .toc li { padding: .2rem 0; border-left: 2px solid var(--line); padding-left: .7rem; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: #fff; }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }
</style>

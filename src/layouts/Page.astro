---
import Base from './Base.astro';
interface Props { frontmatter?: { title: string; description: string; eyebrow?: string }; title?: string; description?: string; eyebrow?: string; }
const fm = Astro.props.frontmatter ?? Astro.props;
---
<Base title={fm.title} description={fm.description}>
  <div class="container">
    <header class="page-head">
      {fm.eyebrow && <p class="eyebrow">{fm.eyebrow}</p>}
      <h1>{fm.title}</h1>
      <p>{fm.description}</p>
    </header>
    <div class="prose"><slot /></div>
  </div>
</Base>

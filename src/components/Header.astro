---
const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/laboratorios/', label: 'Laboratorios' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Inicio: Claudia Muñoz Ausecha, Ciberseguridad">
      <img src="/favicon.svg" width="40" height="40" alt="" />
      <span class="brand-text"><b>Claudia Muñoz Ausecha</b><small>CIBERSEGURIDAD</small></span>
    </a>
    <nav aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      </nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(8px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: .7rem; color: #fff; }
  .brand:hover { text-decoration: none; }
  .brand img { display: block; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text b { font-size: 1.02rem; }
  .brand-text small { font-family: var(--font-mono); color: var(--accent); font-size: .7rem; letter-spacing: .08em; }
  .bar { padding-block: .5rem; }
  nav { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: .95rem; }
  nav a { color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: #fff; text-decoration: none; }
  nav a[aria-current='page'] { box-shadow: 0 2px 0 var(--accent); }
  .rss { font-family: var(--font-mono); font-size: .8rem; border: 1px solid var(--line); padding: .05rem .45rem; border-radius: 5px; }
</style>
